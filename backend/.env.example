# ===== PayOS (payment gateway) — điền giá trị thật từ dashboard PayOS =====
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL webhook đăng ký trên dashboard PayOS (production: domain thật, không dùng ngrok)
PAYOS_WEBHOOK_URL=
# URL redirect sau khi user thanh toán / hủy trên trang PayOS
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Reconciliation job (fix HIGH #1) — 'true' = DRY_RUN: chỉ log kết quả đối
# chiếu PayOS, KHÔNG ghi DB. Chuyển 'false' sau khi review log lần chạy đầu.
PAYMENT_RECONCILE_DRY_RUN=true
