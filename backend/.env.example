# ============ Server ============
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ============ Database ============
DATABASE_URL=postgresql://jobmatch:jobmatch_dev_pwd@localhost:5432/jobmatch_vn
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============ Redis ============
REDIS_URL=redis://localhost:6379

# ============ Auth / JWT ============
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes-gcm-aaaa

# ============ OAuth ============
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/facebook/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback

# ============ AI (single model: Google Gemini) ============
GEMINI_API_KEY=

# Gemini models (override defaults nếu cần)
GEMINI_EMBEDDING_MODEL=text-embedding-004   # 768-dim cho embeddings table
GEMINI_CHAT_MODEL=gemini-1.5-flash          # chatbot + parsing (CV parse)
GEMINI_PRO_MODEL=gemini-1.5-pro             # generation (CV score / cover letter / JD gen / AI test)

# Embedding dim (khớp với schema: vector(768))
EMBEDDING_DIM=768

# ============ Storage (MinIO / S3) ============
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=jobmatch_minio
S3_SECRET_KEY=jobmatch_minio_pwd
S3_BUCKET=jobmatch-uploads
S3_PUBLIC_URL=http://localhost:9000/jobmatch-uploads

# ============ Email (MailHog for dev) ============
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jobmatch.vn

# ============ Payment (PayOS) ============
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=http://localhost:5000/api/v1/webhooks/payos

# ============ Logging ============
LOG_LEVEL=info
LOG_PRETTY=true

# ============ Rate limit ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
OAUTH_RATE_LIMIT_MAX=10